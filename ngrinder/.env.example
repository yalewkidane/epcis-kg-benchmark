# nGrinder stack configuration (copy to .env; every value is optional)

# Host port of the controller's web UI. The agent downloads itself from this port.
NGRINDER_WEB_PORT=8080

# Address of the controller as seen from the agent (host network). Keep 127.0.0.1 when the
# agent runs on the same host as the controller; use the controller host's IP otherwise.
NGRINDER_CONTROLLER_HOST=127.0.0.1

# Where controller state (scripts, test history, reports, H2 database) and agent state are
# kept on the host: <dir>/controller and <dir>/agent. Relative to this folder.
NGRINDER_DATA_DIR=./data

# ngrinder/controller and ngrinder/agent image tag (3.5.9-p1 at the time of writing)
NGRINDER_IMAGE_TAG=latest
